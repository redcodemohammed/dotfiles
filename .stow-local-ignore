# What stow must NOT link into ~ (Perl regexes, one per line).
# This file replaces stow's built-in ignore list, so those defaults are repeated first.
# No "/" in a pattern: matches a file or folder name at any depth.
# A "/" in a pattern: matches the path from the repo root, e.g. ^/spec.

# stow's built-in defaults (Stow.pm, stow 2.4.1)
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

# Hyprland project files: they live in the repo, not in ~
^/CLAUDE\.md
^/HANDOFF\.md
^/pkglist-before\.txt
^/spec
^/design-system
^/palette
^/packages
^/setup
^/pam
^/keyd
^/strongswan
^/greeter
^/grub
^/plymouth
^/spotifast
^/strata
^/vicinae-extensions
^/vscode
^/obsidian
# Vicinae rewrites it (a real file replaces the link): copied once, see the file
^/\.config/vicinae/settings\.json

