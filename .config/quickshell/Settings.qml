pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Hyprland
import Quickshell.Io

// Desktop settings (owner, 2026-10-17; the settings panel, SettingsPanel.qml). One file,
// ~/.config/desktop-settings.json (not in the repo: this machine's state), read and written through
// JsonAdapter. The shell binds to these properties directly. Apps that can't read JSON get a
// generated file each, written 300 ms after the last change (a run of clicks writes once):
//   Hyprland  ~/.config/hypr/hypr_settings.lua, then `hyprctl reload` (hyprland.lua lays it over
//             its defaults; a missing or broken file falls back to them)
//   Alacritty ~/.config/alacritty/settings.toml (imported; Alacritty reloads it by itself)
// Both are gitignored. A missing one is written once at start, so a fresh clone catches up.
Singleton {
    id: root
    readonly property string home: Quickshell.env("HOME")
    signal panelRequested(string screen) // each bar's SettingsPanel listens for its own screen

    IpcHandler {
        target: "settings"
        function toggle(): void {
            const monitor = Hyprland.focusedMonitor
            if (monitor)
                root.panelRequested(monitor.name)
        }
    }

    // Look (step 4a), Input (4b), Bar & island (4c). Defaults are today's values. Bar & island
    // is read by the shell alone (Clock, Bar, IslandState): no generated file.
    readonly property alias look: adapter.look
    readonly property alias input: adapter.input
    readonly property alias bar: adapter.bar

    FileView {
        id: file
        path: root.home + "/.config/desktop-settings.json"
        printErrors: false
        atomicWrites: true
        watchChanges: true
        onFileChanged: reload()
        onAdapterUpdated: {
            writeAdapter()
            applyTimer.restart()
        }

        JsonAdapter {
            id: adapter
            property JsonObject look: JsonObject {
                property int gapsBetween: 6  // px between two windows, 0-24 step 2
                property int gapsEdge: 6     // px at the screen edges and the bar, 0-24
                property int border: 2       // px, 1-4 (never 0: the border shows focus)
                property bool blur: true
                property int blurSize: 6     // 2-12
                property int terminalOpacity: 90 // %, 70-100
                property bool animations: true
            }
            property JsonObject input: JsonObject {
                property int repeatDelay: 600   // ms before a held key repeats, 200-600
                property int repeatRate: 25     // repeats per second, 20-50
                property int pointerSpeed: 0    // tenths, -10 to 10 (Hyprland's -1.0 to 1.0)
                property bool naturalScroll: true
                property bool tapToClick: true
            }
            property JsonObject bar: JsonObject {
                property bool clock24: true
                property bool seconds: false
                property bool otherScreens: true // bars on the screens without the full bar
                property bool islandMedia: true  // the island shows what plays
            }
        }
    }

    Timer {
        id: applyTimer
        interval: 300
        onTriggered: root.apply(true)
    }

    function hyprText() {
        const l = adapter.look
        const i = adapter.input
        return "-- Generated by the shell's settings panel (quickshell/Settings.qml) from\n"
            + "-- ~/.config/desktop-settings.json. Do not edit: change it in the panel.\n"
            + "return {\n"
            + "    gaps_in     = " + Math.round(l.gapsBetween / 2) + ",\n"
            + "    gaps_out    = " + l.gapsEdge + ",\n"
            + "    border_size = " + l.border + ",\n"
            + "    blur        = " + l.blur + ",\n"
            + "    blur_size   = " + l.blurSize + ",\n"
            + "    animations  = " + l.animations + ",\n"
            + "    repeat_delay   = " + i.repeatDelay + ",\n"
            + "    repeat_rate    = " + i.repeatRate + ",\n"
            + "    sensitivity    = " + (i.pointerSpeed / 10).toFixed(1) + ",\n"
            + "    natural_scroll = " + i.naturalScroll + ",\n"
            + "    tap_to_click   = " + i.tapToClick + ",\n"
            + "}\n"
    }
    function alacrittyText() {
        return "# Generated by the shell's settings panel (quickshell/Settings.qml) from\n"
            + "# ~/.config/desktop-settings.json. Do not edit: change it in the panel.\n"
            + "[window]\n"
            + "opacity = " + (adapter.look.terminalOpacity / 100).toFixed(2) + "\n"
    }
    // Only a file whose text changed is written (and Hyprland reloaded): a clock or island
    // setting touches neither.
    property string hyprWritten: ""
    property string alacrittyWritten: ""
    function apply(reloadHypr) {
        const h = hyprText()
        if (h !== hyprWritten) {
            hyprWritten = h
            hyprFile.setText(h)
            if (reloadHypr)
                Quickshell.execDetached(["hyprctl", "reload"])
        }
        const a = alacrittyText()
        if (a !== alacrittyWritten) {
            alacrittyWritten = a
            alacrittyFile.setText(a)
        }
    }

    FileView {
        id: hyprFile
        path: root.home + "/.config/hypr/hypr_settings.lua"
        printErrors: false
        atomicWrites: true
        // Missing (a fresh clone): write it once the settings are in, and reload Hyprland.
        onLoaded: root.hyprWritten = text()
        onLoadFailed: missingTimer.restart()
    }
    FileView {
        id: alacrittyFile
        path: root.home + "/.config/alacritty/settings.toml"
        printErrors: false
        atomicWrites: true
        onLoaded: root.alacrittyWritten = text()
        onLoadFailed: missingTimer.restart()
    }
    Timer { // after desktop-settings.json has had its chance to load
        id: missingTimer
        interval: 1000
        onTriggered: root.apply(true)
    }
}
