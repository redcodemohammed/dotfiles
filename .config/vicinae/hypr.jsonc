// Hand-written Vicinae settings, imported by settings.json.
// settings.json is rewritten by the Vicinae GUI and wins over this file,
// so keep it to the imports line and set everything here.
{
	// No system info sent to the Vicinae server.
	"telemetry": {
		"system_info": false
	},

	// No input monitoring helper. Clipboard entries copy instead of paste,
	// and snippet expansion is off.
	"input_server": {
		"enabled": false
	},

	// Generated from the shared palette: themes/hypr.toml.
	// Dark only: both appearances use it, since the portal reports no preference.
	"theme": {
		"light": { "name": "hypr" },
		"dark": { "name": "hypr" }
	},

	// Same font as the bar and terminal. Size left to Vicinae.
	"font": {
		"normal": { "family": "JetBrainsMono Nerd Font" }
	},

	// Sharp, flat, solid. 640px wide (owner asked for a bit bigger than the
	// spec's 560 on the laptop). Height: 48 search + 8 rows of 40 + footer.
	"launcher_window": {
		// See-through, blurred by Hyprland's layer rule (owner, 2026-10-17); 1 is solid.
		"opacity": 0.9,
		"material": "none",
		"rounding": 0,
		"client_side_decorations": {
			"enabled": true,
			"border_width": 2,
			"shadow_size": 0
		},
		"size": {
			"width": 640,
			"height": 416
		}
	}
}
