// The starting settings.json for a new machine: copy it, don't link it (owner, 2026-10-18).
//   cp ~/dotfiles/.config/vicinae/settings.json ~/.config/vicinae/settings.json
// Vicinae rewrites this file whenever a setting changes in its window, which replaced the stow
// link with a real file and blocked `stow -R .`; so it is in .stow-local-ignore. Shared settings
// live in hypr.jsonc (stowed); this machine's extension settings in local.jsonc (not in git).
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "imports": [
      "hypr.jsonc",
      "local.jsonc"
   ]
}
