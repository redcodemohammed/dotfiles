#!/usr/bin/env python3
# sys-top [count]: the processes using the most CPU right now, as JSON for the bar's system panel
# (owner, 2026-10-18): [{name, cpu, mem}], cpu in percent of one core summed over the sample
# (so up to 100 x cores), mem in bytes (resident). Samples /proc for 1 s, so the figures are
# current, unlike ps (which averages over each process's whole life).
import json, os, sys, time

count = int(sys.argv[1]) if len(sys.argv) > 1 else 3
tick = os.sysconf("SC_CLK_TCK")
page = os.sysconf("SC_PAGE_SIZE")


def sample():
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
            with open(f"/proc/{pid}/statm") as f:
                rss = int(f.read().split()[1]) * page
        except (OSError, IndexError, ValueError):
            continue  # gone, or a kernel thread without memory
        name = stat[stat.index("(") + 1:stat.rindex(")")]
        fields = stat[stat.rindex(")") + 2:].split()
        out[pid] = (name, int(fields[11]) + int(fields[12]), rss)  # utime + stime
    return out


first = sample()
start = time.monotonic()
time.sleep(1)
second = sample()
elapsed = time.monotonic() - start

# Processes of one program (Zen's content processes, node workers) add up under one name.
rows = {}
for pid, (name, ticks, rss) in second.items():
    if pid not in first or rss == 0:
        continue
    cpu = (ticks - first[pid][1]) / tick / elapsed * 100
    row = rows.setdefault(name, {"name": name, "cpu": 0.0, "mem": 0})
    row["cpu"] += cpu
    row["mem"] += rss

top = sorted(rows.values(), key=lambda r: (r["cpu"], r["mem"]), reverse=True)[:count]
for r in top:
    r["cpu"] = round(r["cpu"], 1)
print(json.dumps(top))
